{
  "name": "dont-wake-the-dragon",
  "version": "1.0.0",
  "private": true,
  "description": "Don't Wake the Dragon — a push-your-luck treasure heist for CrazyGames",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip-dist.mjs",
    "playtest": "node tests/playtest.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:platform": "node tests/platform.mjs",
    "test:balance": "node tests/balance.mjs",
    "covers": "node scripts/render-covers.mjs",
    "previews": "node scripts/record-previews.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
